# ── Email (OTP delivery) ──────────────────────────────────────────
# Copy this file to .env and fill in your real values.
# Never commit .env to version control.

# Gmail SMTP via App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_gmail_app_password

# ── Resend (alternative to SMTP) ─────────────────────────────────
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ── Database ──────────────────────────────────────────────────────
# DATABASE_URL=mysql://user:pass@host:3306/dbname

# ── App ───────────────────────────────────────────────────────────
# REQUIRED: used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_to_a_random_64_char_hex_string

# SESSION_SECRET=change_me_in_production

# ── Google Maps ─────────────────────────────────────────────────────
# REQUIRED for Google Maps integration. Get from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Enable: Maps JavaScript API and Geocoding API
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
